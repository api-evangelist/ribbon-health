                },
                {
                  "disabled": false,
                  "key": "tin_ids",
                  "value": "<string>",
                  "description": "Comma separated list of TINs.\nNote: This parameter cannot be used in combination with any other parameters."
                },
                {
                  "disabled": false,
                  "key": "has_tin",
                  "value": "<boolean>",
                  "description": "Boolean input that applies to tin_confirmed field."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "The page of the results which was returned."
                },
                {
                  "disabled": false,
