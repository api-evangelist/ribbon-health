                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "String input that fuzzy searches across tins, name, address, and legal_name."
                },
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "The billing entity name that appears on claims data, or if available, the official legal name of the billing entity.\nString input that is fuzzy matched against the `name` field.\nNote: This parameter will not match with the `legal_name` field, only the `name` field."
                },
                {
                  "disabled": false,
                  "key": "legal_name",
                  "value": "<string>",
